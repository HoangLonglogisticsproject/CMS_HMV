# --- Runtime ---
PORT=4000
NODE_ENV=development
# CHANGE_ME = POSTGRES_PASSWORD from ../.env (URL-encode it if it contains reserved characters).
DATABASE_URL=postgresql://hmv_user:CHANGE_ME@localhost:5442/hmv_cms?schema=public
# Comma-separated origins of the CMS frontend. Required in production. Also used for the CSRF Origin check.
CORS_ORIGIN=http://localhost:3000
# Express "trust proxy" (e.g. 1 behind one reverse proxy / Cloudflare). Needed for correct client IPs in rate limits and audit logs.
TRUST_PROXY=
SESSION_TTL_HOURS=12

# --- Media ---
MEDIA_MAX_BYTES=10485760
# local = files on disk served at /media-files (dev/test only); r2 = Cloudflare R2
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage/media
# Public base URL of stored objects (R2 custom domain in production)
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media-files
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override of https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (e.g. a local S3-compatible server)
R2_ENDPOINT=

# --- Integration tests only (database name must end with _test) ---
# Defaults to DATABASE_URL's server with the database hmv_cms_test (E2E: hmv_cms_e2e_test). Override if needed:
# TEST_DATABASE_URL=postgresql://hmv_user:CHANGE_ME@localhost:5442/hmv_cms_test?schema=public
