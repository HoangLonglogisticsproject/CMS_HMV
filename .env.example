# Docker Compose (development PostgreSQL). Copy to `.env` (gitignored) and choose a password.
# The postgres image only uses it to create the `hmv_user` role when the `postgres_data` volume is first initialised;
# after that the role keeps its own password (change it with `\password`, see docs/operations/auth-runbook.md).
# backend/.env DATABASE_URL must use the same password.
POSTGRES_PASSWORD=CHANGE_ME
